{
  "id": "prefixdiary",
  "title": "Prefix Diary",
  "description": "Look up Canadian telephone assignments and trace IPv4 or IPv6 registration blocks across ARIN reports.",
  "category": "liminal-tools",
  "tags": [
    "Canada",
    "telephone",
    "carrier",
    "604",
    "902",
    "exchange",
    "IPv4",
    "IPv6",
    "ARIN"
  ],
  "icon": "network",
  "url": "/prefixdiary/",
  "source": "https://github.com/jsdyer/prefixdiary",
  "hosting": "project",
  "access": "browser",
  "data_info": {
    "mode": "snapshot",
    "detail": "The Canadian Numbering Administrator supplies telephone assignments. ARIN publishes dated IPv4 and IPv6 delegations by registration economy.",
    "cadence": "Tuesday–Saturday (UTC)",
    "probes": [
      {
        "label": "Data retrieved",
        "url": "https://coolcode.ca/prefixdiary/status.json",
        "path": [
          "retrieved"
        ],
        "count_at": {
          "path": [
            "count"
          ],
          "unit": "prefixes"
        }
      },
      {
        "label": "Latest source date",
        "url": "https://coolcode.ca/prefixdiary/status.json",
        "path": [
          "latest"
        ]
      },
      {
        "label": "IP report date",
        "url": "https://coolcode.ca/prefixdiary/ip/status.json",
        "path": [
          "latest"
        ],
        "count_at": {
          "path": [
            "count"
          ],
          "unit": "IP registration records"
        }
      }
    ]
  }
}
